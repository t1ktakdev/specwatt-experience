{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "surface": {
      "canvas": {
        "$type": "color",
        "$value": "#17191a"
      },
      "raised": {
        "$type": "color",
        "$value": "#252728"
      },
      "elevated": {
        "$type": "color",
        "$value": "#2b2d2d"
      },
      "inset": {
        "$type": "color",
        "$value": "#1e2122"
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "#f4f1ea"
      },
      "secondary": {
        "$type": "color",
        "$value": "#a7aaa5"
      }
    },
    "accent": {
      "amber": {
        "$type": "color",
        "$value": "#edb17c"
      },
      "amberBright": {
        "$type": "color",
        "$value": "#f5bf8c"
      }
    },
    "status": {
      "protected": {
        "$type": "color",
        "$value": "#b8c9b0"
      },
      "warning": {
        "$type": "color",
        "$value": "#e9b887"
      },
      "error": {
        "$type": "color",
        "$value": "#f1a893"
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "$value": ["Manrope", "Arial", "sans-serif"]
    }
  },
  "radius": {
    "card": {
      "$type": "dimension",
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "control": {
      "$type": "dimension",
      "$value": {
        "value": 18,
        "unit": "px"
      }
    },
    "small": {
      "$type": "dimension",
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "hero": {
      "$type": "dimension",
      "$value": {
        "value": 28,
        "unit": "px"
      }
    },
    "device": {
      "$type": "dimension",
      "$value": {
        "value": 22,
        "unit": "px"
      }
    },
    "instrument": {
      "$value": {
        "value": 18,
        "unit": "px"
      },
      "$type": "dimension"
    }
  },
  "spacing": {
    "unit": {
      "$type": "dimension",
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "screen": {
      "$type": "dimension",
      "$value": {
        "value": 23,
        "unit": "px"
      }
    },
    "scale": [4, 8, 12, 16, 20, 24, 32, 40, 48]
  },
  "motion": {
    "press": {
      "$type": "duration",
      "$value": {
        "value": 200,
        "unit": "ms"
      }
    },
    "screen": {
      "$type": "duration",
      "$value": {
        "value": 350,
        "unit": "ms"
      }
    },
    "chart": {
      "$value": {
        "value": 420,
        "unit": "ms"
      },
      "$type": "duration"
    }
  },
  "typography": {
    "display": {
      "fontSize": 55,
      "fontWeight": 400,
      "lineHeight": 1.08
    },
    "metric": {
      "fontSize": 62,
      "fontWeight": 400,
      "lineHeight": 1
    },
    "heading": {
      "fontSize": 27,
      "fontWeight": 500,
      "lineHeight": 1.3
    },
    "section": {
      "fontSize": 15,
      "fontWeight": 600
    },
    "body": {
      "fontSize": 13,
      "fontWeight": 400,
      "lineHeight": 1.7
    },
    "caption": {
      "fontSize": 11,
      "fontWeight": 500,
      "lineHeight": 1.6
    },
    "analytics": {
      "fontSize": 58,
      "fontWeight": 400,
      "lineHeight": 1.1
    }
  },
  "touch": {
    "minimum": 44,
    "preferred": 48
  }
}
