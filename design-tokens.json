{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "surface": {
      "canvas": { "$type": "color", "$value": "#17191a" },
      "raised": { "$type": "color", "$value": "#252728" },
      "elevated": { "$type": "color", "$value": "#2b2d2d" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "#f4f1ea" },
      "secondary": { "$type": "color", "$value": "#979a98" }
    },
    "accent": {
      "amber": { "$type": "color", "$value": "#edb17c" },
      "amberBright": { "$type": "color", "$value": "#f5bf8c" }
    },
    "status": {
      "protected": { "$type": "color", "$value": "#b8c9b0" },
      "warning": { "$type": "color", "$value": "#e9b887" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "$value": ["Manrope", "Arial", "sans-serif"]
    }
  },
  "radius": {
    "card": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
    "control": {
      "$type": "dimension",
      "$value": { "value": 18, "unit": "px" }
    },
    "small": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } }
  },
  "spacing": {
    "unit": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "screen": { "$type": "dimension", "$value": { "value": 23, "unit": "px" } }
  },
  "motion": {
    "press": { "$type": "duration", "$value": { "value": 200, "unit": "ms" } },
    "screen": { "$type": "duration", "$value": { "value": 350, "unit": "ms" } }
  },
  "typography": {
    "display": { "fontSize": 57, "fontWeight": 400, "lineHeight": 1.02 },
    "metric": { "fontSize": 57, "fontWeight": 500, "lineHeight": 1 },
    "heading": { "fontSize": 27, "fontWeight": 500, "lineHeight": 1.3 },
    "section": { "fontSize": 15, "fontWeight": 600 },
    "body": { "fontSize": 12, "fontWeight": 400, "lineHeight": 1.8 },
    "caption": { "fontSize": 10, "fontWeight": 400, "lineHeight": 1.6 }
  }
}
